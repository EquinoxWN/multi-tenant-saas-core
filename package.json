{
  "name": "multi-tenant-saas-core",
  "version": "0.1.0",
  "private": true,
  "description": "One customer must never see another's data: multi-tenant isolation with a test suite that actively tries to break in.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/db/migrate.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "5.9.3"
  }
}
